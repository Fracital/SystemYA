
DATABASE_URL=
AI_BASE=
AI_KEY=
AI_MODEL=
AI_REASONING=

# Server-side community chat, based on Fracital's Holt relay.
# SystemYA is registered for https://systemya.fracit.al only.
# Supply the operator-issued secret privately on the production server.
# Visitors never configure a chat origin or license.
HOLT_LICENSE=
HOLT_PLATFORM=systemya
HOLT_ORIGIN=https://holt.abstracteducation.loan
# Set to 1 only when your trusted reverse proxy overwrites X-Real-IP.
HOLT_TRUST_PROXY=0

# Holt guest mode: public channels can be read anonymously.
# Posting requires a verified __Secure-better-auth.session_token session.
# GET /api/me/chat currently returns 401 until SystemYA adds Better Auth.
