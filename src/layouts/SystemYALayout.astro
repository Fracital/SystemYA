---
import { ClientRouter } from "astro:transitions";
// Every page links every stylesheet. A stylesheet imported only from a client module is injected
// at runtime in dev, and the router drops it on the next page swap.
import "../systemya/account.css";
import "../systemya/shell.css";
import "../systemya/theatre.css";
import "../systemya/proxy.css";
import "../systemya/omni.css";
import { getSystemYASnapshot, type SystemYAPage } from "../systemya/snapshot";
import { obfuscationRules } from "../systemya/obfuscate";
import { bookLinks, entryScript } from "../systemya/routes";
import { pageTemplates } from "../systemya/route-pages";

interface Props {
  page: SystemYAPage;
  title?: string;
  // Full-screen pages (chat, proxy) set #root[data-fullscreen="1"]: the navbar stays at the top,
  // the footer is hidden, the page does not scroll, and #root > main fills the rest of the
  // viewport. See src/systemya/shell.css for the contract.
  fullscreen?: boolean;
}

const { page, title = "SystemYA", fullscreen = false } = Astro.props;
// Links in the route book's form (/?1), never the page's own path.
const markup = bookLinks(getSystemYASnapshot(page));
const rules = obfuscationRules();
// "/" (index.html) serves every number, so it carries every page: the entry script shows the
// one the address names and the router (src/systemya/router.ts) navigates without fetching. The
// old paths' files (/theatre.html, /app/) carry only their own page; leaving one fetches "/".
// See src/systemya/routes.ts.
const templates = page === "index" ? pageTemplates() : [];
const entry = entryScript();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/systemya-2022/favicon.png" />
    <link rel="stylesheet" href="/systemya-2022/main.css" />
    <noscript><style is:inline set:html={rules.join("")}></style></noscript>
    <script is:inline>
      // A stale tab may request a removed hashed chunk and receive index.html.
      window.addEventListener("vite:preloadError", (event) => {
        event.preventDefault();
        try {
          const key = "systemya:chunk-reload";
          const current = window.location.href;
          if (sessionStorage.getItem(key) !== current) {
            sessionStorage.setItem(key, current);
            window.location.reload();
          } else {
            sessionStorage.removeItem(key);
            window.location.assign("/");
          }
        } catch {
          window.location.reload();
        }
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <div
      id="root"
      data-page={page === "index" ? "home" : page}
      data-theme="light"
      data-fullscreen={fullscreen ? "1" : "0"}
      set:html={markup}
    />
    <div id="systemya-pages" hidden>
      {
        templates.map((t) => (
          <template
            data-page={t.page}
            data-title={t.title}
            data-fullscreen={t.fullscreen ? "1" : "0"}
            set:html={t.markup}
          />
        ))
      }
    </div>
    <script is:inline set:html={entry} />
    <script is:inline data-astro-rerun data-rules={JSON.stringify(rules)}>
      // 2022's style component: insert the obfuscation rules into the app's <style> through CSSOM.
      {
        const rules = JSON.parse(document.currentScript.dataset.rules);
        const root = document.getElementById("root");
        let style = root && root.querySelector(":scope > style");
        if (root && !style) root.prepend((style = document.createElement("style")));
        const sheet = style && style.sheet;
        if (sheet && !sheet.cssRules.length) for (const rule of rules) sheet.insertRule(rule, sheet.cssRules.length);
      }
    </script>
    <script>
      import "../systemya/interactions.ts";
    </script>
  </body>
</html>
